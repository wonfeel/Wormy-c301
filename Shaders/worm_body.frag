// Shaders/worm_body.frag
//
// Тело червя как треугольная лента (см. WormApp::buildBodyMesh) — этот
// шейдер только красит готовую геометрию: базовый полупрозрачный
// "кутикульный" тон -> тёплое свечение там, где локальная кривизна велика
// (реальная мышечная активность, не декоративная анимация), плюс полосы
// вдоль тела (сегментация) и подсветка головы.
#version 460 core
in float vGlow;
in float vAlong;
out vec4 FragColor;

void main() {
    vec3 base = vec3(0.55, 0.42, 0.38);
    vec3 hot  = vec3(1.0, 0.75, 0.35);
    float t = clamp(vGlow, 0.0, 1.0);
    vec3 color = mix(base, hot, t);

    // Сегментация: лёгкая периодическая полоса вдоль длины тела, чтобы
    // читалось как членистое тело, а не гладкая лента.
    float band = 0.92 + 0.08 * sin(vAlong * 90.0);
    color *= band;

    // Голова (vAlong около 0) - холодный (голубоватый) отлив, а не просто
    // "светлее": проверено (tests/worm_chemotaxis_calibration's временный
    // режим "wavedir" - см. историю в WormSim.cpp/applyProprioception),
    // что points_[0]/vAlong=0 и есть голова (её же физически ведущий конец,
    // dot~-0.96..-1.0 против хвоста на 80 независимых прогонах, agar и
    // water, короткие и длинные) - сам механизм локомоции не "задом
    // наперёд". Прежний маркер (просто добавлял тёплый оттенок) конкурировал
    // с vGlow (тоже тёплый, activity-glow) и на практике тонул в нём, когда
    // активность была выше у хвоста - визуально читалось как "светится
    // ХВОСТ, значит голова где-то там сзади" ровно наоборот. У base/hot
    // почти нет синего канала (0.38/0.35) - подмешивание синего у самого
    // vAlong=0 не путается с glow ни при какой его интенсивности.
    color += vec3(-0.10, 0.05, 0.35) * smoothstep(0.15, 0.0, vAlong);

    FragColor = vec4(color, 1.0);
}
